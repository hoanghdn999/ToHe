  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Chi\u1EC1u 30 T\u1EBFt, l\xE0ng Xu\xE2n La r\u1ED9n r\xE0ng ti\u1EBFng
    rao, ti\u1EBFng c\u01B0\u1EDDi v\xE0 s\u1EAFc \u0111\u1ECF kh\u1EAFp n\u1EBBo.
    b\u1EA1n l\xE0 ng\u01B0\u1EDDi ch\xE1u sau nhi\u1EC1u n\u0103m \u0111i h\u1ECDc
    xa tr\u1EDF v\u1EC1, mang trong l\xF2ng c\u1EA3m gi\xE1c th\xE2n quen l\u1EABn
    xa l\u1EA1.\n\nTrong s\xE2n nh\xE0 c\u0169 \u1EDF \u0111\u1EA7u l\xE0ng, \xF4ng
    c\u1EE7a b\u1EA1n, m\u1ED9t ngh\u1EC7 nh\xE2n t\xF2 he l\xE2u n\u0103m, \u0111ang
    chu\u1EA9n b\u1ECB cho bu\u1ED5i b\xE1n cu\u1ED1i c\xF9ng tr\u01B0\u1EDBc giao
    th\u1EEBa. Tr\xEAn b\xE0n l\xE0 khay b\u1ED9t n\u0103m m\xE0u - tinh hoa c\u1EE7a
    c\u1EA3 \u0111\u1EDDi l\xE0m ngh\u1EC1.\r\n\r\nB\u1EA5t ng\u1EDD, m\u1ED9t con
    m\xE8o hoang nh\u1EA3y v\u1ECDt l\xEAn b\xE0n.\r\nKhay b\u1ED9t b\u1ECB h\u1EA5t
    \u0111\u1ED5.\r\n\nMu\u1ED1n ti\u1EBFp t\u1EE5c l\xE0m t\xF2 he, ch\u1EC9 c\xF2n
    c\xE1ch t\u1EA1o l\u1EA1i n\u0103m m\xE0u b\u1ED9t t\u1EEB \u0111\u1EA7u.\r\n\r\nH\xE3y
    xu\u1ED1ng phi\xEAn ch\u1EE3 T\u1EBFt g\u1EB7p c\xE1c ngh\u1EC7 nh\xE2n, gi\u1EA3i
    m\xE3 nh\u1EEFng manh m\u1ED1i c\xF2n s\xF3t l\u1EA1i \u0111\u1EC3 gi\xFAp \xF4ng
    k\u1ECBp ho\xE0n th\xE0nh tr\u01B0\u1EDBc gi\u1EDD giao th\u1EEBa nh\xE9!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e6a9ac63ee054764b9649e57c67a190e, type: 2}
