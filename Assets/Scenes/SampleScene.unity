--- !u!114 &834013782
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 834013779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ec57afdca660a849812d53c9044de87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data:
    npcName: "\xD4ng N\u1ED9i"
    talkLines:
    - "Kh\xE1 l\u1EAFm! \u0110\xF4i tay ch\xE1u \u0111\xE3 b\u1EAFt \u0111\u1EA7u
      bi\u1EBFt l\u1EAFng nghe nh\u1ECBp th\u1EDF c\u1EE7a m\xE0u s\u1EAFc v\xE0
      c\xE1i d\u1EBBo th\u01A1m c\u1EE7a h\u1EA1t g\u1EA1o n\u1EBFp qu\xEA m\xECnh
      r\u1ED3i \u0111\xF3."
    - "Ch\xE1u th\u1EA5y \u0111\u1EA5y, t\xF2 he kh\xF4ng \u0111\u01A1n thu\u1EA7n
      l\xE0 m\xF3n \u0111\u1ED3 ch\u01A1i, m\xE0 l\xE0 'h\u1EA1t ng\u1ECDc' c\u1EE7a
      \u0111\u1EA5t tr\u1EDDi \u0111\u01B0\u1EE3c k\u1EBFt tinh t\u1EEB \u0111\xF4i
      b\xE0n tay v\xE0 t\u1EA5m l\xF2ng thi\u1EC7n l\xE0nh c\u1EE7a ng\u01B0\u1EDDi
      th\u1EE3."
    - "M\u1ED7i con t\xF2 he l\xE0 m\u1ED9t l\u1EDDi ch\xFAc b\xECnh an, l\xE0 c\xE1ch
      ta g\u1EEDi g\u1EAFm c\xE1i h\u1ED3n c\u1EE7a l\xE0ng qu\xEA v\xE0 nh\u1EEFng
      c\xE2u chuy\u1EC7n x\u01B0a c\u0169 v\xE0o h\u01A1i \u1EA5m c\u1EE7a n\u1EAFm
      b\u1ED9t."
    question: "V\u1EADy ch\xE1u ngh\u0129 xem, s\u1EE9c s\u1ED1ng c\u1EE7a m\u1ED9t
      con t\xF2 he n\u1EB1m \u1EDF n\u1EAFm b\u1ED9t d\u1EBBo tr\xEAn tay, hay n\u1EB1m
      \u1EDF n\u1EE5 c\u01B0\u1EDDi c\u1EE7a ng\u01B0\u1EDDi \u0111\xF3n nh\u1EADn
      n\xF3?"
    answers:
    - "N\xF3 n\u1EB1m trong qu\xE1 tr\xECnh l\xE0m t\xF2 he \u1EA1."
    - "Ch\xE1u ngh\u0129 l\xE0 t\u1EEB nguy\xEAn li\u1EC7u m\xE0 c\xE1c b\xE1c n\xF4ng
      d\xE2n \u0111\xE3 c\u1EADt l\u1EF1c t\u1EA1o n\xEAn \u1EA1."
    - "C\xE1i quan tr\u1ECDng nh\u1EA5t ch\xEDnh l\xE0 c\xE2u chuy\u1EC7n c\u1EE7a
      m\u1ED7i con t\xF2 he \u1EA1."
    - "N\u1EB1m \u1EDF c\u1EA3 hai \u1EA1."
    correctIndex: 1
    postWinLine: "Gi\u1ECFi l\u1EAFm! Ch\u1EC9 c\u1EA7n con hi\u1EC3u \u0111\u01B0\u1EE3c
      \u0111i\u1EC1u \u0111\xF3, linh h\u1ED3n c\u1EE7a ngh\u1EC1 t\xF2 he s\u1EBD
      m\xE3i s\u1ED1ng c\xF9ng con."
    rewardItem: {fileID: 11400000, guid: 275bf9f43365eb04e9f27e76e3606378, type: 2}
    winLine: Win.
    loseLine: "Gi\u1ECFi l\u1EAFm! Ch\u1EC9 c\u1EA7n con hi\u1EC3u \u0111\u01B0\u1EE3c
      \u0111i\u1EC1u \u0111\xF3, linh h\u1ED3n c\u1EE7a ngh\u1EC1 t\xF2 he s\u1EBD
      m\xE3i s\u1ED1ng c\xF9ng con."
  hasWon: 0
